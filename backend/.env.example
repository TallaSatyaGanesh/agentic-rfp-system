# Environment & Server
ENVIRONMENT=development
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# LLM Configuration (OpenAI, Gemini, or Mock)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Database & Chroma Storage Paths
DATABASE_URL=sqlite:///./storage/rfp_system.db
CHROMA_PERSIST_DIRECTORY=./storage/chromadb
UPLOAD_DIR=./storage/uploads
EXPORT_DIR=./storage/exports

# Multi-Agent Workflow Guardrails
SIMILARITY_THRESHOLD=0.35
RAG_TOP_K=4
MAX_REVISION_CYCLES=2
REVIEW_PASS_SCORE=80
